# .env
DB_HOST=host
DB_PORT=porta
DB_USER=user
DB_PASSWORD=password
DB_NAME=name

OUTPUT_DIR=./output
SERVER_PORT=4444
LOGO_PATH=assets/logo.png

# executável do Chromium usado para gerar os PDFs (opcional)
CHROMIUM_PATH=/usr/bin/chromium

# Caminho absoluto no servidor onde cada pasta de inscrição está armazenada.
# Ajuste para a instalação local do Mapas: <FILES_DIR>/<registration_id>/*.pdf.
# O Docker monta essa origem automaticamente em /data/registration (somente leitura).
FILES_DIR=/srv/mapas/docker-data/private-files/registration
